# Flutter
flutter/**/.dart_tool/
flutter/**/.packages
flutter/**/build/
flutter/**/.flutter-plugins
flutter/**/.flutter-plugins-dependencies
flutter/**/pubspec.lock
flutter/**/generated_plugin_registrant.dart

# UI / React / Node
ui/node_modules/
ui/**/node_modules/
ui/.turbo/
ui/**/.turbo/
ui/**/dist/
ui/**/.next/
ui/**/storybook-static/
ui/**/coverage/
ui/**/*.tsbuildinfo

# SDK
sdk/**/dist/
sdk/**/node_modules/

# General
.DS_Store
*.pem
.env*.local

# Build artifacts (binaries built into the repo root, e.g. /specgen
# from sdkgen/cmd/specgen, /standalone from cmd/standalone). These are
# large, machine-specific, and should never be committed.
/specgen
/standalone

# Editor / agent ephemera.
#
# The whole directory is ignored: alongside settings it holds .claude/worktrees,
# which are full checkouts of this repo (100s of MB). A single `git add -A`
# would otherwise commit a copy of the tree into itself.
#
# Negated below are the files that are genuinely shared configuration and
# belong in version control.
# Note the trailing /* rather than a bare .claude/ — git does not descend into
# an excluded directory, so the negations below would never be reachable.
.claude/*
!.claude/settings.json
!.claude/agents/
!.claude/commands/
!.claude/skills/

# Agent workspace scratch (subagent task notes, plan drafts, etc.).
# Not authoritative — the source of truth lives in docs/ or commit
# messages. Gitignored so the agent loop doesn't leak ephemeral
# state into the repo.
_project_files/

# Subagent-driven-development workspaces (ledgers, briefs, review packages).
# Ephemeral coordination state; git history is the record.
.superpowers/

# Superpowers working documents: design specs and implementation plans.
# Kept on disk for whoever is mid-task against them, but not committed.
docs/superpowers/

# The cloud control plane. Private by policy, and this is enforced by
# scripts/check-private-paths.sh rather than trusted to this file alone.
#
# Go's module proxy archives the whole module tree at every tagged version
# and serves it forever, so anything committed here and tagged is public
# permanently. cloud/ went out that way in v0.0.1 through v0.0.16 and
# proxy.golang.org still serves those versions. Deleting a tag does not
# take it back.
cloud/
