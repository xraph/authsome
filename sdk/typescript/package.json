{
  "name": "@authsome/client",
  "version": "0.5.0",
  "description": "TypeScript client for AuthSome API",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "module": "dist/index.mjs",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc --emitDeclarationOnly && esbuild src/index.ts --bundle --platform=neutral --target=es2020 --format=cjs --sourcemap --outfile=dist/index.js && esbuild src/index.ts --bundle --platform=neutral --target=es2020 --format=esm --sourcemap --outfile=dist/index.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "keywords": [
    "authsome",
    "auth",
    "authentication",
    "sdk"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/xraph/authsome.git",
    "directory": "sdk/typescript"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "typescript": "^5.0.0",
    "vitest": "4.1.11"
  }
}
